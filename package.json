{
  "name": "ESMA",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.3",
    "@sap/cds": "^9",
    "@sap/hana-client": "^2.30.27",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "@sap/hdi-deploy": "5.7.0",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employeemanage": "cds watch --open employeemanage/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy ESMA --delete-services --delete-service-keys --delete-service-brokers",
    "build": "mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-esmaui": "cds watch --open esmaui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-esma-ui": "cds watch --open esmaui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-skills-ui": "cds watch --open skillsui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-projects-ui": "cds watch --open projectsui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-certifications-ui": "cds watch --open certificationsui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": "hana",
      "auth": "dummy",
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employeemanage",
    "app/esmaui",
    "app/esma-ui",
    "app/skills-ui",
    "app/projects-ui",
    "app/certifications-ui"
  ]
}